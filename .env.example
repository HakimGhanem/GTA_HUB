# Public site URL (canonical — used in sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://map-6.com
NEXT_PUBLIC_CANONICAL_HOST=map-6.com

# ── Analytics & search consoles ───────────────────────────────────
# GA4: Admin → Data streams → Measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console → HTML tag → content value only
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools → meta tag msvalidate.01 content value
NEXT_PUBLIC_BING_VERIFICATION=

# Microsoft Clarity (optional — heatmaps, session replay)
NEXT_PUBLIC_CLARITY_ID=

# ── Google AdSense ────────────────────────────────────────────────
# AdSense → Account → Account information → Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# AdSense → Ads → By ad unit → create units, copy slot IDs
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
# true only after AdSense leaves "Getting ready" (hides empty ad shells)
NEXT_PUBLIC_ADSENSE_UNITS=false

# ── Amazon Associates (affiliate) ─────────────────────────────────
# 1) partners.amazon.fr → get store ID (e.g. map6-21)
# 2) Browse product → SiteStripe → copy ASIN
# 3) Redeploy Cloud Build with substitutions _AMAZON_* (or set .env.local)
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=
NEXT_PUBLIC_AMAZON_STORE=https://www.amazon.fr
# Optional multi-store tags (src/lib/affiliate/stores.ts)
# NEXT_PUBLIC_AMAZON_US_TAG=
# NEXT_PUBLIC_AMAZON_DE_TAG=
# NEXT_PUBLIC_AMAZON_ES_TAG=
# NEXT_PUBLIC_AMAZON_IT_TAG=
# NEXT_PUBLIC_FNAC_AFFILIATE_BASE=
NEXT_PUBLIC_AMAZON_ASIN_GTA6_PS5=
NEXT_PUBLIC_AMAZON_ASIN_GTA6_XBOX=
NEXT_PUBLIC_AMAZON_ASIN_GTA6_COLLECTORS_PS5=
NEXT_PUBLIC_AMAZON_ASIN_GTA6_COLLECTORS_XBOX=
NEXT_PUBLIC_AMAZON_ASIN_PS5=
NEXT_PUBLIC_AMAZON_ASIN_XBOX_SERIES_X=
NEXT_PUBLIC_AMAZON_ASIN_DUALSENSE=
# Extended funnel slots (setup / creators / retro)
NEXT_PUBLIC_AMAZON_ASIN_DUALSENSE_WHITE=
NEXT_PUBLIC_AMAZON_ASIN_XBOX_PAD=
NEXT_PUBLIC_AMAZON_ASIN_DUALSENSE_EDGE=
NEXT_PUBLIC_AMAZON_ASIN_PULSE_3D=
NEXT_PUBLIC_AMAZON_ASIN_ARCTIS_NOVA=
NEXT_PUBLIC_AMAZON_ASIN_SSD_1TB=
NEXT_PUBLIC_AMAZON_ASIN_HDMI_21_TV=
NEXT_PUBLIC_AMAZON_ASIN_CAPTURE_CARD=
NEXT_PUBLIC_AMAZON_ASIN_CHARGE_DOCK=
NEXT_PUBLIC_AMAZON_ASIN_GTA5_PS5=

# IndexNow key (random 32-char hex) — also save as public/{KEY}.txt
INDEXNOW_KEY=

# ── Content engine (news detect → draft → review → publish) ───────
# Required for /api/content/* and /api/indexnow
CONTENT_API_SECRET=
# Optional: override publish target (default NEXT_PUBLIC_SITE_URL)
# SITE_INTERNAL_URL=https://map-6.com
# Firestore (optional — default is data/content/*.json file store)
# FIRESTORE_ENABLED=true
# FIRESTORE_PROJECT_ID=gtahub-503009
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# LLM for drafts (optional — template fallback if unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Daily funnel (17:00 Europe/Paris via Cloud Scheduler)
CONTENT_DAILY_LIMIT=2
CONTENT_DAILY_AUTO_PUBLISH=false
# SITE_INTERNAL_URL=https://map-6.com
# After deploy: CONTENT_API_SECRET=... bash scripts/setup-content-scheduler.sh

# ── Multi-game maps (GTA 6 stays default) ───────────────────────────
# GTA 5 — npm run tiles:fetch-gtadb-gta5 (GTADB satellite, CC BY 4.0)
# NEXT_PUBLIC_GTA5_GTADB_ENABLED=true
# NEXT_PUBLIC_GTA5_GTADB_NATIVE=true
# NEXT_PUBLIC_GTA5_GTADB_TILE_SET=satellite
# NEXT_PUBLIC_GTA5_GTADB_MAP_IMAGE=/tiles/los-santos-stitched.jpg
# NEXT_PUBLIC_GTA5_MAP_MIN_X=-4224
# NEXT_PUBLIC_GTA5_MAP_MAX_X=4992
# NEXT_PUBLIC_GTA5_MAP_MIN_Y=-5120
# NEXT_PUBLIC_GTA5_MAP_MAX_Y=8448
# Host XYZ tiles then point env → /map?game=gta5 | sa
# NEXT_PUBLIC_VC_MAP_IMAGE=/tiles/vc-map.png
# NEXT_PUBLIC_SA_MAP_IMAGE=/tiles/sa-map.png
# NEXT_PUBLIC_GTA5_RASTER_TILES_URL=/tiles/gta5/{z}/{x}/{y}.png
# NEXT_PUBLIC_VC_RASTER_TILES_URL=/tiles/vc/{z}/{x}/{y}.png
# NEXT_PUBLIC_SA_RASTER_TILES_URL=/tiles/sa/{z}/{x}/{y}.png
# NEXT_PUBLIC_GTA5_PMTILES_URL=
# NEXT_PUBLIC_VC_PMTILES_URL=
# NEXT_PUBLIC_SA_PMTILES_URL=

# ── GTADB tiles (recommended) ──────────────────────────────────────
# Run: npm run tiles:fetch-gtadb
# NEXT_PUBLIC_GTADB_ENABLED=true
# NEXT_PUBLIC_GTADB_NATIVE=true          # local: native tiles; prod Cloud Run: false + stitched image
# NEXT_PUBLIC_GTADB_TILE_SET=yanis,13
# NEXT_PUBLIC_GTADB_MAP_IMAGE=/tiles/leonida-stitched.jpg
# NEXT_PUBLIC_MAP_MIN_X=-16384
# NEXT_PUBLIC_MAP_MAX_X=3584
# NEXT_PUBLIC_MAP_MIN_Y=-8064
# NEXT_PUBLIC_MAP_MAX_Y=12032

# ── Alternative tile sources ───────────────────────────────────────
# NEXT_PUBLIC_PMTILES_URL=/tiles/leonida.pmtiles
# NEXT_PUBLIC_RASTER_TILES_URL=/tiles/raster/{z}/{x}/{y}.png

# Public site URL (canonical — used in sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://map-6.com
NEXT_PUBLIC_CANONICAL_HOST=map-6.com

# ── Analytics & search consoles ───────────────────────────────────
# GA4: Admin → Data streams → Measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console → HTML tag → content value only
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools → meta tag msvalidate.01 content value
NEXT_PUBLIC_BING_VERIFICATION=

# Microsoft Clarity (optional — heatmaps, session replay)
NEXT_PUBLIC_CLARITY_ID=

# ── Google AdSense ────────────────────────────────────────────────
# AdSense → Account → Account information → Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# AdSense → Ads → By ad unit → create units, copy slot IDs
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=

# ── Amazon Associates (affiliate) ─────────────────────────────────
# Partners → Amazon.fr → your store ID (e.g. map6-21)
# NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=map6-21
# NEXT_PUBLIC_AMAZON_STORE=https://www.amazon.fr
# Product ASINs — copy from SiteStripe after browsing Amazon.fr
# NEXT_PUBLIC_AMAZON_ASIN_GTA6_PS5=
# NEXT_PUBLIC_AMAZON_ASIN_GTA6_XBOX=
# NEXT_PUBLIC_AMAZON_ASIN_PS5=

# IndexNow key (random 32-char hex) — also save as public/{KEY}.txt
INDEXNOW_KEY=

# ── GTADB tiles (recommended) ──────────────────────────────────────
# Run: npm run tiles:fetch-gtadb
# NEXT_PUBLIC_GTADB_ENABLED=true
# NEXT_PUBLIC_GTADB_NATIVE=true          # local: native tiles; prod Cloud Run: false + stitched image
# NEXT_PUBLIC_GTADB_TILE_SET=yanis,13
# NEXT_PUBLIC_GTADB_MAP_IMAGE=/tiles/leonida-stitched.jpg
# NEXT_PUBLIC_MAP_MIN_X=-16384
# NEXT_PUBLIC_MAP_MAX_X=3584
# NEXT_PUBLIC_MAP_MIN_Y=-8064
# NEXT_PUBLIC_MAP_MAX_Y=12032

# ── Alternative tile sources ───────────────────────────────────────
# NEXT_PUBLIC_PMTILES_URL=/tiles/leonida.pmtiles
# NEXT_PUBLIC_RASTER_TILES_URL=/tiles/raster/{z}/{x}/{y}.png

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env (never commit secrets / local overrides)
.env.local
.env*.local
.env

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# GTADB cache + large tile assets (run npm run tiles:fetch-gtadb)
.cache/
public/tiles/gtadb/
public/tiles/leonida-stitched.jpg
public/tiles/los-santos-stitched.jpg
public/tiles/gtadb-gta5-manifest.json
data/gtadb/
data/gtadb-gta5/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

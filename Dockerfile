ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_GTADB_ENABLED=$NEXT_PUBLIC_GTADB_ENABLED
ENV NEXT_PUBLIC_GTADB_NATIVE=$NEXT_PUBLIC_GTADB_NATIVE
ENV NEXT_PUBLIC_GTADB_MAP_IMAGE=$NEXT_PUBLIC_GTADB_MAP_IMAGE
ENV NEXT_PUBLIC_MAP_MIN_X=$NEXT_PUBLIC_MAP_MIN_X
ENV NEXT_PUBLIC_MAP_MAX_X=$NEXT_PUBLIC_MAP_MAX_X
ENV NEXT_PUBLIC_MAP_MIN_Y=$NEXT_PUBLIC_MAP_MIN_Y
ENV NEXT_PUBLIC_MAP_MAX_Y=$NEXT_PUBLIC_MAP_MAX_Y
ENV NEXT_PUBLIC_MAP_CENTER_X=$NEXT_PUBLIC_MAP_CENTER_X
ENV NEXT_PUBLIC_MAP_CENTER_Y=$NEXT_PUBLIC_MAP_CENTER_Y
ENV NEXT_PUBLIC_MAP_MAX_ZOOM=$NEXT_PUBLIC_MAP_MAX_ZOOM
ENV NEXT_PUBLIC_ADSENSE_CLIENT=$NEXT_PUBLIC_ADSENSE_CLIENT
ENV NEXT_PUBLIC_ADSENSE_SLOT_BANNER=$NEXT_PUBLIC_ADSENSE_SLOT_BANNER
ENV NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=$NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=$NEXT_PUBLIC_GA_MEASUREMENT_ID
ENV NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=$NEXT_PUBLIC_AMAZON_AFFILIATE_TAG
ENV NEXT_PUBLIC_AMAZON_STORE=$NEXT_PUBLIC_AMAZON_STORE
ENV NEXT_PUBLIC_AMAZON_ASIN_GTA6_PS5=$NEXT_PUBLIC_AMAZON_ASIN_GTA6_PS5
ENV NEXT_PUBLIC_AMAZON_ASIN_GTA6_XBOX=$NEXT_PUBLIC_AMAZON_ASIN_GTA6_XBOX
ENV NEXT_PUBLIC_AMAZON_ASIN_GTA6_COLLECTORS_PS5=$NEXT_PUBLIC_AMAZON_ASIN_GTA6_COLLECTORS_PS5
ENV NEXT_PUBLIC_AMAZON_ASIN_GTA6_COLLECTORS_XBOX=$NEXT_PUBLIC_AMAZON_ASIN_GTA6_COLLECTORS_XBOX
ENV NEXT_PUBLIC_AMAZON_ASIN_PS5=$NEXT_PUBLIC_AMAZON_ASIN_PS5
ENV NEXT_PUBLIC_AMAZON_ASIN_XBOX_SERIES_X=$NEXT_PUBLIC_AMAZON_ASIN_XBOX_SERIES_X
